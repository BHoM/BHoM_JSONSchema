{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "https://raw.githubusercontent.com/BHoM/BHoM_JSONSchema/v9.3/SQLite_oM/Objects/ColumnFilter.json",
  "title" : "ColumnFilter",
  "type" : ["object", "null"],
  "description" : "ColumnFilter: Represents a filter condition for a specific database column with support for multiple values (IN clause).",
  "properties" : {
    "ColumnName" : {
      "type" : ["string", "null"],
      "description" : "Name of the database column to filter on."
    },
    "Values" : {
      "type" : ["array", "null"],
      "description" : "List of values to match against for this column. Multiple values create an IN clause condition.",
      "items" : { }
    },
    "BHoM_Guid" : {
      "type" : "string",
      "format" : "uuid"
    },
    "Name" : {
      "type" : ["string", "null"]
    },
    "Fragments" : {
      "$ref" : "https://raw.githubusercontent.com/BHoM/BHoM_JSONSchema/v9.3/BHoM/FragmentSet.json"
    },
    "Tags" : {
      "type" : ["array", "null"],
      "items" : {
        "type" : ["string", "null"]
      },
      "uniqueItems" : true
    },
    "CustomData" : {
      "type" : ["object", "null"]
    },
    "_t" : {
      "type" : "string",
      "description" : "Optional type disciminator.",
      "const" : "BH.oM.SQLite.Objects.ColumnFilter"
    },
    "_bhomVersion" : {
      "type" : ["string", "null"],
      "description" : "Optional version of BHoM used as part of automatic versioning and schema upgrades."
    }
  },
  "required" : ["ColumnName", "Values"]
}