{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "https://raw.githubusercontent.com/BHoM/BHoM_JSONSchema/develop/MidasCivil_oM/TimeHistorySettings.json",
  "title" : "TimeHistorySettings",
  "type" : ["object", "null"],
  "properties" : {
    "LinearType" : {
      "description" : "Indicates whether the time history analysis is performed linear or nonlinear.",
      "$ref" : "https://raw.githubusercontent.com/BHoM/BHoM_JSONSchema/develop/MidasCivil_oM/LinearType.json"
    },
    "IntegrationMethod" : {
      "description" : "Indicates how Midas performs the time history calculation.",
      "$ref" : "https://raw.githubusercontent.com/BHoM/BHoM_JSONSchema/develop/MidasCivil_oM/IntegrationMethod.json"
    },
    "DampingMethod" : {
      "description" : "Specifies how the damping matrix is calculated in the analysis.",
      "$ref" : "https://raw.githubusercontent.com/BHoM/BHoM_JSONSchema/develop/MidasCivil_oM/DampingMethod.json"
    },
    "TimeHistoryType" : {
      "description" : "Describes the type of time‑dependent loading used in the analysis.",
      "$ref" : "https://raw.githubusercontent.com/BHoM/BHoM_JSONSchema/develop/MidasCivil_oM/TimeHistoryType.json"
    },
    "DynamicLoadType" : {
      "description" : "Defines how the starting state for the time history analysis is determined. \nIt can either begin from the model’s initial, unloaded state (InitialLoad) \nor continue from the final state of another load case (SequentialOrder).",
      "$ref" : "https://raw.githubusercontent.com/BHoM/BHoM_JSONSchema/develop/MidasCivil_oM/DynamicLoadType.json"
    },
    "BHoM_Guid" : {
      "type" : "string",
      "format" : "uuid"
    },
    "Name" : {
      "type" : ["string", "null"]
    },
    "Fragments" : {
      "$ref" : "https://raw.githubusercontent.com/BHoM/BHoM_JSONSchema/develop/BHoM/FragmentSet.json"
    },
    "Tags" : {
      "type" : ["array", "null"],
      "items" : {
        "type" : ["string", "null"]
      },
      "uniqueItems" : true
    },
    "CustomData" : {
      "type" : ["object", "null"]
    },
    "_t" : {
      "type" : "string",
      "description" : "Optional type disciminator.",
      "const" : "BH.oM.Adapters.MidasCivil.TimeHistorySettings"
    },
    "_bhomVersion" : {
      "type" : ["string", "null"],
      "description" : "Optional version of BHoM used as part of automatic versioning and schema upgrades."
    }
  },
  "required" : ["LinearType", "IntegrationMethod", "DampingMethod", "TimeHistoryType", "DynamicLoadType"]
}